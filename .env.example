# Copy to .env and fill in. Never commit .env.
PORT=3000
# Long random string (>= 32 chars), e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Initial admin account (created on first start if it does not exist yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Set to true when served over HTTPS
SECURE_COOKIES=false
# Where the SQLite database and uploaded files live
DATA_DIR=data
STORAGE_DIR=storage
MAX_UPLOAD_MB=15
SESSION_HOURS=12
